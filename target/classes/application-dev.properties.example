# =============================
# DEVELOPMENT ENVIRONMENT TEMPLATE
# Hospital Management System
# Copy this file to application-dev.properties and fill in your values
# =============================

# =============================
# APPLICATION CONFIGURATION
# =============================
spring.application.name=test
server.port=8090
spring.config.import=optional:file:.env

# =============================
# DATABASE CONFIGURATION
# =============================
spring.datasource.url=jdbc:mysql://your-database-host:3306/your-database-name
spring.datasource.username=your-username
spring.datasource.password=your-password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# =============================
# JPA/HIBERNATE CONFIGURATION
# =============================
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# =============================
# MAIL CONFIGURATION
# =============================
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# =============================
# LOGGING CONFIGURATION
# =============================
logging.level.org.springframework.mail=DEBUG
logging.level.javax.mail=DEBUG
logging.level.com.example.Hospital=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# =============================
# SECURITY CONFIGURATION (tạm tắt user mặc định nếu chưa cần)
# =============================
# spring.security.user.name=${ADMIN_USERNAME}
# spring.security.user.password=${ADMIN_PASSWORD}
# spring.security.user.roles=${ADMIN_ROLES}

# =============================
# SESSION CONFIGURATION (tạm tắt nếu chưa dùng)
# =============================
spring.session.store-type=none

# =============================
# DEVELOPMENT SPECIFIC
# =============================
management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=always
spring.devtools.restart.enabled=true
spring.devtools.livereload.enabled=true

# =============================
# SPRING AI (tắt nếu không dùng)
# =============================
spring.ai.vectorstore.mongodb.atlas.enabled=false
spring.autoconfigure.exclude=org.springframework.ai.vectorstore.mongodb.autoconfigure.MongoDBAtlasVectorStoreAutoConfiguration,org.springframework.ai.autoconfigure.vectorstore.mongo.MongoDBVectorStoreAutoConfiguration,org.springframework.ai.autoconfigure.vectorstore.common.VectorStoreAutoConfiguration

